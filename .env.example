# Database. postgres:// and postgresql:// are both accepted -- managed providers
# hand out the former.
DATABASE_URL=postgresql://username:password@localhost:5432/language_learning

# JWT. Must be at least 32 characters; the server refuses to boot otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# LLM
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server
PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
# Leave unset in development: Vite proxies /api, so requests are same-origin.
# Required in production, where the frontend is deployed separately.
# CORS_ORIGIN=https://your-app.vercel.app
