# Database. postgres:// and postgresql:// are both accepted -- managed providers
# hand out the former.
DATABASE_URL=postgresql://username:password@localhost:5432/language_learning

# JWT. Must be at least 32 characters; the server refuses to boot otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# LLM
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server
PORT=3001
NODE_ENV=development

# Optional. Falls back to Jina Reader when a URL can't be read here -- mainly
# pages that build themselves with JavaScript, which this server never runs.
# Leave it unset and that fallback is simply skipped. Free key at jina.ai;
# anonymous requests are refused, so there is no useful default.
# Enabling this sends the article URL to a third party.
# JINA_API_KEY=jina_...

# Comma-separated browser origins allowed to call this API.
# Leave unset in development: Vite proxies /api, so requests are same-origin.
# Required in production, where the frontend is deployed separately.
# CORS_ORIGIN=https://your-app.vercel.app
